{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebAppUrl": "https://YOUR_VERCEL_DOMAIN",
  "Authentication": {
    "Cookie": {
      "SameSite": "None",
      "SecurePolicy": "Always"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Payments": {
    "Provider": "stripe",
    "Stripe": {
      "ApiKey": "",
      "WebhookSecret": "",
      "SuccessUrl": "",
      "CancelUrl": ""
    }
  },
  "Gateway": {
    "Provider": "openrouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKey": ""
  }
}